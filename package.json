{
  "name": "aurafx",
  "version": "1.0.1",
  "description": "Plug-and-play visual effects toolkit for the modern web. Lightweight, hardware-accelerated, zero-dependency.",
  "type": "module",
  "main": "./dist/aurafx.umd.cjs",
  "module": "./dist/aurafx.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/aurafx.js",
      "require": "./dist/aurafx.umd.cjs"
    },
    "./style.css": "./src/styles/aurafx.css",
    "./dist/aurafx.css": "./src/styles/aurafx.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:types": "tsc -p tsconfig.types.json",
    "build:lib": "vite build --config vite.config.lib.ts && npm run build:types && cp src/styles/aurafx.css dist/aurafx.css",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "keywords": [
    "animation",
    "cursor",
    "scroll-reveal",
    "visual-effects",
    "tilt",
    "glow",
    "ripple",
    "magnetic",
    "ambient",
    "creative-web",
    "motion",
    "micro-interactions",
    "ui-effects"
  ],
  "author": "AuraFX Maintainers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurafx/aurafx.git"
  },
  "bugs": {
    "url": "https://github.com/aurafx/aurafx/issues"
  },
  "homepage": "https://github.com/aurafx/aurafx#readme",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
